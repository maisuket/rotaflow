# ---- server/.env ----
# Chave SECRETA do servidor. Habilite "Distance Matrix API" e "Directions API"
# no Google Cloud Console. Restrinja por IP do servidor (nao por referrer).
GOOGLE_MAPS_API_KEY=

# Porta do servidor Express
PORT=3001

# Banco de dados. SQLite local por padrao (caminho relativo a server/prisma/).
# Para trocar pro Neon: DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# e mude o "provider" em server/prisma/schema.prisma de "sqlite" para "postgresql".
DATABASE_URL="file:../data/borabora.db"

# Senha compartilhada simples pra proteger a API (nao e um sistema de contas —
# so um segredo unico). Deixe em branco pra usar sem senha (padrao, bom pra
# uso local). DEFINA isso antes de expor o servidor alem do seu localhost.
APP_PASSWORD=

# ---- client/.env ----
# Chave CLIENT-SIDE, exposta no bundle do navegador de proposito.
# Habilite apenas "Maps JavaScript API" e restrinja por referrer HTTP
# (ex: localhost:5173/*, seu-dominio.com/*). NUNCA reutilize a chave do servidor aqui.
VITE_GOOGLE_MAPS_JS_KEY=
